# Written by `npx convex dev`: the deployment this checkout talks to.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Explicit HTTP-action origin. Hosted deployments can derive this from the
# .convex.cloud URL, but setting it prevents a deployed client from displaying
# a loopback URL left over from local development.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set on the Convex deployment with `npx convex env set`, not in this file:
#
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
#   Google Cloud OAuth web client. Authorized redirect URI:
#   <convex-site-url>/api/auth/callback/google
#
# PLATFORM_ADMIN_EMAILS
#   Comma-separated operator email allowlist for /admin and every cross-org
#   read. An org role or database flag never grants platform access.
#
# WA_WEBHOOK_VERIFY_TOKEN
#   Random retained value matching the Meta app's webhook verification token.
#
# WA_APP_SECRET
#   Meta app secret used for X-Hub-Signature-256 verification. Required in
#   production; without it the WhatsApp webhook logs a warning and accepts
#   unsigned payloads for local-development convenience.
#
# RESEND_API_KEY
#   Enables customer email and owner alerts.
#
# RESEND_INBOUND_DOMAIN
#   One verified inbound domain shared by all orgs. Routing uses the org's
#   configured local part.
#
# RESEND_WEBHOOK_SECRET
#   The whsec value for the Resend `email.received` webhook at
#   <convex-site-url>/email/inbound.
#
# SITE_URL
#   Public Randevu frontend origin, used in invitation email links.
#
# DEMO_ORG_ID (optional)
#   Enables anonymous sign-in only for an org already marked demoMode and kept
#   free of real credentials.

# Per-org configuration is never stored as a shared deployment fallback:
# - Phone-provider API keys are installed by the platform operator in /admin
#   and stored in org-scoped `connections` rows.
# - WhatsApp account credentials are stored in `waAccounts`; reminder/template
#   controls live under Reminders.
# - cal.com API keys and event-type IDs are operator-managed per org.
