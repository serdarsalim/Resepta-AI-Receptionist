# Written by `npx convex dev` — the deployment this checkout talks to.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Set on the CONVEX deployment (npx convex env set), not here:
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET
#       — Google Cloud OAuth web client. Authorized redirect URI is
#         <NEXT_PUBLIC_CONVEX_SITE_URL>/api/auth/callback/google
#         (local dev: http://127.0.0.1:3213/api/auth/callback/google)
#   RETELL_API_KEY  — Retell's API key, and ALSO what signs their webhooks.
#       Unset means /retell/functions and /retell/call-ended accept unsigned
#       requests, which is fine in dev and a hole in production. It was
#       missing from this file, so nothing prompted anyone to set it.
#   WA_WEBHOOK_VERIFY_TOKEN  — any random string; must match the verify token
#                              entered in the Meta app's webhook config at
#                              <convex-site-url>/whatsapp/webhook
#   WA_APP_SECRET            — the Meta APP secret; enables X-Hub-Signature-256
#                              verification on the webhook. REQUIRED in prod
#                              (unset = fail-open with a console warning, dev only)
#
# Per-org WhatsApp credentials (access token, phone number id) are entered in
# Settings → WhatsApp and stored per org — never as deployment env vars.
#   RESEND_API_KEY          — Resend API key. Sends customer email and owner
#                             alerts; unset = the email lane is off entirely.
#   RESEND_INBOUND_DOMAIN   — the domain customers write TO. ONE verified
#                             domain serves every org: routing happens on the
#                             local part (each org's inboundAddress, set in
#                             Business settings), not on the domain.
#   RESEND_WEBHOOK_SECRET   — the whsec_… from the Resend webhook you point at
#                             <convex-site-url>/email/inbound for
#                             `email.received`. Unset = the route answers 503
#                             and drops mail rather than trusting it unverified.
